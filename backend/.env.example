# AutoPersona AI Environment Configuration
APP_NAME=AutoPersona AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite:///./autopersona.db

# AI & Search Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=your_tavily_api_key_here

# Autonomous Persona Settings
PERSONA_NAME=Ada
PERSONA_DOMAIN="AI Security"
DEFAULT_EDITORIAL_THRESHOLD=7.0
SCHEDULER_INTERVAL_HOURS=4
TOPIC_SEARCH_INTERVAL_HOURS=1

# Breeth Memory Settings
BREETH_MEMORY_MAX_ITEMS=5000
BREETH_SIMILARITY_THRESHOLD=0.82
